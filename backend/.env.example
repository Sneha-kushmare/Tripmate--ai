# Optional Gemini API key. Without this, local itinerary generation is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set comma-separated frontend origins for deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase placeholders for future database integration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
